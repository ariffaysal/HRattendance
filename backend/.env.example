# MySQL Configuration (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_db
DB_USER=root
DB_PASSWORD=

# Application Settings
PORT=3001
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads

# Authentication
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Development Settings
# Set to true to use the in-memory mock database instead of MySQL.
# When false and MySQL is unreachable, the server fails to start (it will NOT silently fall back).
USE_MOCK_DB=false
