# PostgreSQL Configuration (Docker Desktop - docker compose up -d)
# Host port 5434 matches docker-compose.yml (5432 may be taken by a local
# PostgreSQL and 5433 by another project's container).
DB_HOST=localhost
DB_PORT=5434
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=postgres

# Application Settings
PORT=3001
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads

# Runtime environment: development | production
# In production the API docs (/api/docs) are disabled and internal error
# details are hidden from responses.
NODE_ENV=development

# Set to false to disable Swagger /api/docs even in development.
SWAGGER_ENABLED=true

# Authentication
# REQUIRED in production - use a long random string (e.g. `openssl rand -hex 32`).
# The server refuses to start in production with the default/empty value.
JWT_SECRET=change-me-to-a-long-random-string

# Development Settings
# Set to true to use the in-memory mock database instead of PostgreSQL.
# When false and PostgreSQL is unreachable, the server fails to start (it will NOT silently fall back).
USE_MOCK_DB=false

# Password for the auto-seeded default admin account (employee ID: admin).
# Only used when the database has no admin yet (registration is disabled).
DEFAULT_ADMIN_PASSWORD=Admin@123
